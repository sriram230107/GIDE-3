# copy to services/api/.env and edit

# Database
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@127.0.0.1:5432/gide
SYNC_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/gide

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Authentication
JWT_SECRET=change-me-to-a-long-random-string

# ============================================================
# AI
# ============================================================

TEXT_PROVIDER=ollama
EMBED_PROVIDER=ollama
VISION_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VERIFIER_MODEL=
GEMINI_EMBED_MODEL=gemini-embedding-001

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=qwen2.5:3b
OLLAMA_TUTOR_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=llama3.2-vision
OLLAMA_VERIFIER_MODEL=llama3.1:8b

# AI runtime
LLM_TIMEOUT_S=180
LLM_MAX_CONCURRENCY=1

# ============================================================
# Ingestion
# ============================================================

WHISPER_MODEL=small
MAX_VISION_CALLS_PER_SOURCE=60
KEYFRAME_THRESHOLD=0.35
KEYFRAME_MAX_GAP_S=30.0
KEYFRAME_MAX_COUNT=80

# ============================================================
# Retrieval / Grounding
# ============================================================

RETRIEVAL_TOP_K=6
CALIBRATION_FILE=evaluation/calibration.json
