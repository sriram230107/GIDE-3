```env
# copy to services/api/.env and edit

# Database
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@127.0.0.1:5432/gide
SYNC_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/gide

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Authentication
JWT_SECRET=change-me-to-a-long-random-string

# ============================================================
# AI
# ============================================================

# Gemini
# Used for multimodal/vision work and can also be used for
# text generation when explicitly selected.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VERIFIER_MODEL=
GEMINI_EMBED_MODEL=gemini-embedding-001

# Ollama
# Local AI server: http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Fast local text generation
OLLAMA_TEXT_MODEL=qwen2.5:3b

# Higher-quality local tutor generation
OLLAMA_TUTOR_MODEL=llama3.1:8b

# Local embeddings
OLLAMA_EMBED_MODEL=nomic-embed-text

# Local vision (used only when VISION_PROVIDER=ollama; no vision model is
# installed locally by default, so the default VISION_PROVIDER=gemini)
OLLAMA_VISION_MODEL=llava

# Higher-quality local model for final live measurements (CPU-slow; use
# qwen2.5:3b for iteration)
OLLAMA_VERIFIER_MODEL=llama3.1:8b

# AI runtime
LLM_TIMEOUT_S=180
LLM_MAX_CONCURRENCY=1

# ============================================================
# Ingestion
# ============================================================

WHISPER_MODEL=small

# Maximum Gemini vision calls allowed per source
MAX_VISION_CALLS_PER_SOURCE=60

# Keyframe extraction
KEYFRAME_THRESHOLD=0.35
KEYFRAME_MAX_GAP_S=30.0
KEYFRAME_MAX_COUNT=80

# ============================================================
# Retrieval / Grounding
# ============================================================

RETRIEVAL_TOP_K=6
```
